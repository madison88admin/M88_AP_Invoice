[TEMPLATE]
# Server
PORT=3001
NODE_ENV=development

# Demo login for quick login buttons (disable in production)
ENABLE_DEMO_LOGIN=true

# Database
# Self-hosted Supabase on VPS
DATABASE_URL="postgresql://supabase_admin:POSTGRES_PASSWORD@5.223.78.194:5432/postgres?schema=AP_Invoice"
# Local dev: DATABASE_URL="postgresql://user:password@localhost:5432/ap_invoice_db"

# JWT Secret (issued by /api/auth/login)
JWT_SECRET=your-jwt-secret-key

# Azure Form Recognizer
AZURE_FORM_RECOGNIZER_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_FORM_RECOGNIZER_KEY=your-form-recognizer-key

# Anthropic (Claude) - OCR fallback when Azure not configured
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Gemini - OCR fallback for low-confidence extractions
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_THRESHOLD=70

# Groq - OCR fallback with higher free-tier limits
# NOTE: llama-3.3-70b-versatile was retired by Groq (404s). groq/compound-mini
# is the current flagship that returns clean JSON.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=groq/compound-mini
GROQ_MAX_TEXT_LENGTH=8000

# OpenRouter - Free-tier vision LLM OCR engine (zero GPU compute; reads page images)
# Runs in parallel with Groq/regex and votes per field via engineConsensus.
# NOTE: .env.example is a committed template — keep the placeholder here and put
# the real key in the gitignored .env (and the VPS .env). The key below is the
# live key; rotate it if this file is ever pushed to a public repository.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_TIMEOUT=90
OPENROUTER_MAX_IMAGE_PAGES=5
OPENROUTER_MAX_TEXT_LENGTH=12000
# Max ms the OCR pipeline waits for OpenRouter to vote before proceeding without it
OPENROUTER_CONSENSUS_WAIT_MS=45000

# Docling - local PDF->Markdown (CPU-only, ~80s/doc) second opinion for problem
# invoices: runs when a critical field (invoice# / vendor / amount) is missing.
DOCLING_FALLBACK_ENABLED=true
DOCLING_PYTHON=python3
DOCLING_TIMEOUT_MS=150000
# DOCLING_SCRIPT=<cwd>/src/python/docling_extract.py (override only if relocated)

# Ollama - Self-hosted LLM fallback
OLLAMA_BASE_URL=http://5.223.78.194:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TEXT_LENGTH=8000

# Qwen (DashScope) - Third LLM engine, runs in parallel with Gemini
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_MODEL=qwen-plus
QWEN_MAX_TEXT_LENGTH=12000

# Finance controls enforcement
# advisory (default): reference-data gaps (missing MPO, PO invoice without line
#   items, unpopulated NextGen quantities) warn but never block; only invoice-internal
#   arithmetic errors block.
# strict: all finance-control issues block (use only after Finance confirms data is clean).
FINANCE_ENFORCEMENT_MODE=advisory
# Comma-separated invoice categories that never require an MPO (NOT_APPLICABLE path).
# Default when unset: SAMPLE_CHARGES,SHIPPING_FREIGHT,LAB_TESTING,FACTORY,FACTORY_AUDIT,
# PROFESSIONAL_FEE,SMS,CONSULTATION,OTHER
# FINANCE_NON_PO_CATEGORIES=SAMPLE_CHARGES,SHIPPING_FREIGHT,LAB_TESTING

# QuickBooks
QUICKBOOKS_CLIENT_ID=your-qb-client-id
QUICKBOOKS_CLIENT_SECRET=your-qb-client-secret
QUICKBOOKS_REDIRECT_URI=http://localhost:3001/auth/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# Microsoft Graph API
GRAPH_API_CLIENT_ID=your-graph-client-id
GRAPH_API_CLIENT_SECRET=your-graph-client-secret
GRAPH_API_TENANT_ID=your-tenant-id

# NextGen (cookie-based auth — uses NextGen login credentials)
NEXTGEN_API_URL=https://nextgen.madison88.com
NEXTGEN_USERNAME=your-nextgen-username
NEXTGEN_PASSWORD=your-nextgen-password
# Read-only request safety and validation thresholds
NEXTGEN_MAX_CONCURRENT_REQUESTS=2
NEXTGEN_REQUEST_DELAY_MS=150
NEXTGEN_RETRY_DELAY_MS=300
NEXTGEN_REQUEST_TIMEOUT_MS=30000
NEXTGEN_FAILURE_THRESHOLD=5
NEXTGEN_COOLDOWN_MS=60000
NEXTGEN_UNIT_PRICE_TOLERANCE=0.01
NEXTGEN_AMOUNT_TOLERANCE_PERCENT=5
NEXTGEN_AMOUNT_WARNING_PERCENT=2

# NextGen Write Mode (TEST ENV ONLY)
# Set to true to enable write operations (create/update lines and sizes)
# Requires a separate NEXTGEN_TEST_API_URL that differs from NEXTGEN_API_URL
# SAFETY: Write operations will be blocked if NEXTGEN_TEST_API_URL equals NEXTGEN_API_URL
NEXTGEN_WRITE_ENABLED=false
NEXTGEN_TEST_API_URL=https://nextgen.madison88.com:8443

# Maximum pages eligible for page-level OCR during multi-invoice boundary detection
MULTI_INVOICE_OCR_PAGE_LIMIT=60

# Optional: map NextGen usernames to AP Invoice roles. JSON object, e.g.
# NEXTGEN_USER_ROLES={"Glecie":"PLANNING_MANAGER","Joy":"PURCHASING_COORDINATOR"}
# If unset, a default map is used; unknown users fall back to IT_ADMIN.

# Approver emails
COORDINATOR_EMAIL=coordinator@madison88.com
PURCHASING_MANAGER_EMAIL=purchasing-manager@madison88.com
MLO_ACCOUNT_HOLDER_EMAIL=mlo-account-holder@madison88.com
MLO_PLANNING_MANAGER_EMAIL=planning-manager@madison88.com
SR_MANAGER_EMAIL=sr-manager@madison88.com
MS_POLLY_EMAIL=ms-polly@madison88.com
ACCOUNTING_EMAIL=accounting@madison88.com
ACCOUNTING_SUPERVISOR_EMAIL=accounting-supervisor@madison88.com

# Escalation email
VP_OPERATIONS_EMAIL=chris.a@madison88.com

# Durable parallel invoice OCR queue. Start with 2 workers on a CPU-only VPS;
# increase only after monitoring RAM and load during a bulk upload.
INVOICE_WORKER_CONCURRENCY=2
INVOICE_QUEUE_DIR=./data/invoice-upload-queue
ASYNC_JOB_RETENTION_MS=86400000
# Failed uploads are retried once per API restart, up to this many total attempts,
# then failed permanently and their payload removed. 0 disables restart retries.
INVOICE_MAX_RETRIES=3
# Payload files (including failed ones) older than this are purged at boot.
INVOICE_QUEUE_RETENTION_MS=604800000
