model CorrectionLog {
  id                String   @id @default(uuid())
  invoice_id        String?
  vendor_name       String?
  invoice_template_type String?
  raw_text          String?
  original_fields   Json?
  corrected_fields  Json?
  note              String?
  vendor_scope_key  String?
  layout_fingerprint String?
  approved_for_learning Boolean @default(false)
  approved_by       String?
  approved_at       DateTime?
  disabled_at       DateTime?
  validation_success_count Int @default(0)
  validation_failure_count Int @default(0)
  use_count         Int      @default(0)
  last_used_at      DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([vendor_name])
  @@index([vendor_scope_key, approved_for_learning, disabled_at])
  @@index([invoice_template_type])
  @@index([use_count])
  @@index([created_at])
  @@map("APInvoice_CorrectionLog")
}

model Notification {
  id           String   @id @default(uuid())
  invoice_id   String?
  invoice_number String?
  vendor_name  String?
  title        String
  message      String
  type         String   @default("info") // info, success, warning, error
  category     String   @default("stage") // stage, exception, approval, upload, payment
  target_role  String?  // null = all roles, or specific role
  is_read      Boolean  @default(false)
  read_at      DateTime?
  created_at   DateTime @default(now())

  @@index([target_role])
  @@index([is_read])
  @@index([created_at])
  @@index([invoice_id])
  @@map("APInvoice_Notification")
}

model EmailIntakeEvent {
  id            String   @id @default(uuid())
  intake_id     String?
  source        String
  mailbox       String?
  message_id    String?
  attachment_id String?
  file_name     String?
  stage         String
  status        String   @default("SUCCESS")
  invoice_id    String?
  error         String?
  metadata      Json?
  created_at    DateTime @default(now())

  @@index([created_at])
  @@index([source, created_at])
  @@index([message_id])
  @@index([intake_id, created_at])
  @@index([status, created_at])
  @@map("APInvoice_EmailIntakeEvent")
}

// Review-only intake records preserve non-payable/ambiguous attachments in a
// searchable queue without creating a payable Invoice row.
model IntakeReviewRecord {
  id              String   @id @default(uuid())
  intake_id       String
  source          String
  mailbox         String?
  message_id      String?
  attachment_id   String?
  file_name       String   @default("")
  storage_path    String?
  document_type   String?
  invoice_number  String?
  reason          String
  status          String   @default("OPEN")
  metadata        Json?
  reviewed_by     String?
  reviewed_at     DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([intake_id, file_name])
  @@index([status, created_at])
  @@index([source, created_at])
  @@index([invoice_number])
  @@map("APInvoice_IntakeReviewRecord")
}

// Durable case for historical email attachments whose original upload event
// predates storage-path capture. The case remains searchable until the source
// PDF is re-supplied or an administrator explicitly closes it.
model IntakeRecoveryCase {
  id                   String   @id @default(uuid())
  intake_id            String   @unique
  source               String
  message_id           String?
  attachment_id        String?
  file_name            String   @default("")
  storage_path         String?
  status               String   @default("SOURCE_RECOVERY_REQUIRED")
  reason               String
  attempts             Int      @default(0)
  last_error           String?
  recovered_invoice_id String?
  metadata             Json?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([status, created_at])
  @@index([source, created_at])
  @@index([file_name])
  @@map("APInvoice_IntakeRecoveryCase")
}

// Retention compliance is a controlled queue, not an automatic destructive
// delete. Disposal is eligible only after expiry, backup attestation, and no
// legal hold; every decision remains auditable.
model RetentionDisposition {
  id                 String   @id @default(uuid())
  invoice_id         String   @unique
  retention_until    DateTime?
  legal_hold         Boolean  @default(false)
  status             String   @default("ACTIVE")
  backup_verified_at DateTime?
  backup_reference   String?
  backup_hash        String?
  eligible_at        DateTime?
  disposed_at        DateTime?
  disposed_by        String?
  disposition_reason String?
  metadata           Json?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  invoice            Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, retention_until])
  @@index([legal_hold, retention_until])
  @@map("APInvoice_RetentionDisposition")
}

model FinanceControlRun {
  id           String   @id @default(uuid())
  run_type     String
  status       String   @default("RUNNING")
  started_at   DateTime @default(now())
  completed_at DateTime?
  summary      Json?
  error        String?
  initiated_by String?
  findings     FinanceControlFinding[]

  @@index([run_type, started_at])
  @@index([status])
  @@map("APInvoice_FinanceControlRun")
}

model FinanceControlFinding {
  id          String   @id @default(uuid())
  run_id      String
  run         FinanceControlRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  invoice_id  String?
  payment_id  String?
  code        String
  severity    String
  detail      String
  fingerprint String
  status      String   @default("OPEN")
  assigned_to String?
  acknowledged_by String?
  acknowledged_at DateTime?
  resolved_by String?
  resolved_at DateTime?
  resolution_note String?
  reopened_by String?
  reopened_at DateTime?
  escalated_to String?
  escalated_at DateTime?
  occurrence_count Int @default(1)
  first_seen_at DateTime @default(now())
  last_seen_at DateTime @default(now())
  created_at  DateTime @default(now())

  @@unique([run_id, fingerprint])
  @@index([invoice_id])
  @@index([code, status])
  @@map("APInvoice_FinanceControlFinding")
}

// Coordinator-editable vendor/brand name aliases. When the real-time NextGen
// check compares names, an alias maps a known formatting variant (e.g.
// "J-LONG LTD.") to its canonical name ("J-Long Ltd") so formatting
// differences stop showing as informational mismatches.
model EntityAlias {
  id          String   @id @default(uuid())
  entity_type String   // VENDOR | BRAND
  canonical   String   // canonical spelling, e.g. "J-Long Ltd"
  alias       String   // known variant, e.g. "J-LONG LTD."
  created_by  String?
  created_at  DateTime @default(now())

  @@unique([entity_type, alias])
  @@index([entity_type, canonical])
  @@map("APInvoice_EntityAlias")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  role          String
  password_hash String
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@map("APInvoice_User")
}
