generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vendor {
  id                      String   @id @default(uuid())
  name                    String   @unique
  name_aliases            String[]
  beneficiary_name        String?
  supplier_location       String?
  invoice_template_type   InvoiceTemplateType
  classification          String?
  // Supplier master defaults imported from the approved supplier list. These
  // are fallbacks only; extracted/manual invoice values always take priority.
  default_payment_terms   String?
  accepted_document_types String[] @default([])
  
  // Bank details
  bank_name               String?
  bank_name_alt           String[]
  bank_address            String?
  account_number          String?
  account_number_alt      String[]
  swift_code              String?
  swift_code_alt          String[]
  iban                    String?
  sort_code               String?
  aba_routing_number      String?
  intermediary_bank_name  String?
  intermediary_bank_swift String?
  has_multiple_accounts   Boolean  @default(false)
  
  // Tax IDs
  gstin_number            String?
  bir_tin                 String?
  vat_number              String?
  eori_number             String?
  
  contact_email           String?
  is_active               Boolean  @default(true)
  onboarded_by            String?
  bank_verified_at        DateTime?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  invoices                Invoice[]
  bank_change_requests    VendorBankChangeRequest[]
  bank_versions           VendorBankVersion[]
  vendor_bill_stubs       VendorBillStub[]
  
  @@index([name])
  @@index([is_active])
  @@map("APInvoice_Vendor")
}

model Invoice {
  id                    String        @id @default(uuid())
  // Permanent AP tracking reference. This is intentionally separate from
  // the supplier invoice number and remains stable across revisions.
  ap_record_id          String        @unique @default(cuid())
  invoice_number        String
  normalized_invoice_number String?
  revision              Int           @default(1)
  invoice_date          DateTime?
  invoice_received_date DateTime?
  due_date              DateTime?
  
  // Amounts
  subtotal              Decimal?
  tax_amount            Decimal?
  discount_amount       Decimal?
  bank_charges          Decimal?
  freight_charges       Decimal?
  additional_charges    Decimal?
  courier_charges       Decimal?
  handling_fee          Decimal?
  tt_charge             Decimal?
  setup_charge          Decimal?
  sample_charge         Decimal?
  min_order_charge      Decimal?
  finance_surcharge     Decimal?
  total_amount          Decimal
  currency              String        @default("USD")
  invoice_currency_original String?
  exchange_rate_to_usd  Decimal?
  
  // Vendor
  vendor_id             String
  vendor                Vendor        @relation(fields: [vendor_id], references: [id])
  vendor_name_raw       String

  // Address / entity fields extracted from invoice
  ship_to               String?
  sold_to               String?

  // PO & order details
  customer_po_number    String?
  mpo_number            String?
  mpo_base_number       String?
  mpo_order_sequence    String?
  material_code         String?
  material_name         String?
  brand_code            String?
  brand                 String?
  brand_tier            BrandTier?
  season                String?
  order_type            OrderType?
  order_type_detail     OrderTypeCombination?
  qty_shipped           Int?
  incoterm              String?
  hs_code               String?
  grand_total           Decimal?
  
  // Invoice classification
  invoice_type          InvoiceType
  invoice_template_type InvoiceTemplateType?
  category              InvoiceCategory @default(TRIMS)
  parent_invoice_id     String?
  parent_invoice        Invoice?      @relation("PItoCI", fields: [parent_invoice_id], references: [id])
  child_invoices        Invoice[]     @relation("PItoCI")
  
  // Date ranges
  date_range_start      DateTime?
  date_range_end        DateTime?
  
  // Status & routing
  status                InvoiceStatus @default(RECEIVED)
  // Stable lifecycle projection used by intake/review/reporting. Legacy
  // status remains for compatibility with existing approval code.
  // Canonical lifecycle projection: RECEIVED, OCR_PROCESSING,
  // NON_PAYABLE_REVIEW, PROFORMA_REVIEW, PURCHASING_REVIEW,
  // ACCOUNTING_REVIEW, DUPLICATE_REVIEW, REVISION_REVIEW, APPROVED,
  // POSTED_TO_QB, PAYMENT_SCHEDULED, PAID, ON_HOLD, REJECTED, CANCELLED.
  workflow_status       String        @default("RECEIVED")
  // Cancellation is an auditable state, never a hard-delete substitute.  The
  // original document, approvals and QuickBooks history remain attached.
  cancellation_requested_by String?
  cancellation_requested_at DateTime?
  cancellation_request_reason String?
  cancelled_by              String?
  cancelled_at              DateTime?
  cancellation_reason       String?
  approval_tier         Int?
  current_approver_role String?
  priority_flag         Boolean       @default(false)
  priority_pay_date     DateTime?
  is_urgent             Boolean       @default(false)
  
  // Validation
  is_duplicate          Boolean       @default(false)
  duplicate_review_status String       @default("NOT_REVIEWED")
  duplicate_review_reason String?
  duplicate_reviewed_by String?
  duplicate_reviewed_at DateTime?
  ocr_confidence_score  Decimal?
  is_handwritten        Boolean       @default(false)
  ocr_raw_data          Json?
  source_document_type  String?
  structured_source_format String?
  document_layout_fingerprint String?
  po_validation         Json?
  exception_reasons     ExceptionReason[]
  
  // Extracted bank info (fallback when vendor bank details are missing)
  beneficiary_name      String?
  bank_name             String?
  swift_code            String?
  account_number        String?
  
  // Duplicate detection hash
  invoice_hash          String?
  line_items_signature  String?
  
  // Bank matching
  bank_match_status     String?
  bank_match_details    Json?
  
  // QuickBooks
  qb_memo               String?
  qb_account_class      String?
  qb_posted_at          DateTime?
  
  // Filing
  sharepoint_folder_url String?
  sharepoint_filed_at   DateTime?
  
  // Bill-to
  bill_to_entity        BillToEntity  @default(MADISON_88_LTD)
  
  // Payment
  payment_terms         String?
  payment_penalty_rate  Decimal?
  
  // Payment confirmation
  confirmation_sent_at  DateTime?
  
  // Meta
  source                InvoiceSource @default(EMAIL)
  raw_file_url          String?
  pdf_path              String?
  source_message_id     String?
  source_attachment_id  String?
  source_received_at    DateTime?
  retention_until       DateTime?
  legal_hold            Boolean       @default(false)
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt
  
  signatures            Signature[]
  stage_timestamps      StageTimestamp[]
  audit_logs            AuditLog[]
  bank_change_requests  BankChangeRequest[]
  payments              Payment[]
  exceptions            Exception[]
  follow_up_tasks       FollowUpTask[]
  payment_confirmations PaymentConfirmation[]
  invoice_lines         InvoiceLine[]
  workflow_actions      InvoiceWorkflowAction[]
  validation_snapshots  ValidationSnapshot[]
  async_jobs            AsyncJob[]
  duplicate_reviews     DuplicateRevisionReview[] @relation("DuplicateReviewInvoice")
  duplicate_candidates  DuplicateRevisionReview[] @relation("DuplicateReviewCandidate")
  quickbooks_reconciliations QuickBooksReconciliation[]
  bank_snapshot          InvoiceBankSnapshot?
  bank_snapshot_revisions InvoiceBankSnapshotRevision[]
  retention_disposition   RetentionDisposition?
  
  @@index([vendor_id])
  @@index([status])
  @@index([invoice_date])
  @@index([invoice_type])
  @@index([bill_to_entity])
  @@index([approval_tier])
  @@index([invoice_hash])
  @@index([invoice_number, vendor_id, invoice_type])
  @@index([mpo_base_number, mpo_order_sequence, material_code])
  @@map("APInvoice_Invoice")
}

model DuplicateRevisionReview {
  id                    String   @id @default(uuid())
  invoice_id            String
  invoice               Invoice  @relation("DuplicateReviewInvoice", fields: [invoice_id], references: [id], onDelete: Cascade)
  candidate_invoice_id  String?
  candidate_invoice     Invoice? @relation("DuplicateReviewCandidate", fields: [candidate_invoice_id], references: [id], onDelete: SetNull)
  status                String   @default("PENDING")
  classification        String?
  reason                String?
  evidence              Json?
  matching_indicators   Json?
  reviewer_id           String?
  reviewed_at           DateTime?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@index([invoice_id, status])
  @@index([candidate_invoice_id])
  @@map("APInvoice_DuplicateRevisionReview")
}

model QuickBooksReconciliation {
  id                  String   @id @default(uuid())
  // Nullable for QUICKBOOKS_ONLY rows, which have no AP invoice to attach.
  invoice_id          String?
  invoice             Invoice? @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  result              String
  qb_transaction_id   String?
  qb_reference        String?
  qb_vendor_name      String?
  qb_invoice_number   String?
  qb_amount           Decimal? @db.Decimal(15, 2)
  qb_open_balance     Decimal? @db.Decimal(15, 2)
  difference_amount   Decimal? @db.Decimal(15, 2)
  exception_code      String?
  review_owner        String?
  comments            String?
  source              String?
  resolution_status   String   @default("OPEN")
  resolved_by        String?
  resolved_at        DateTime?
  resolution_evidence Json?
  reconciled_at      DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([invoice_id, reconciled_at])
  @@index([result, resolution_status])
  @@map("APInvoice_QuickBooksReconciliation")
}

model Signature {
  id            String        @id @default(uuid())
  invoice_id    String
  invoice       Invoice       @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  signatory_name String
  // System user who signed this workflow signature. Set at approve time and
  // retained when the signature is re-opened by a return/reject, so "Returned
  // to Me" can match by user ID instead of by name. Null for OCR-detected and
  // legacy pre-2026-08 signatures.
  signatory_user_id String?
  signatory_role SignatoryRole
  signed_at     DateTime?
  signature_type SignatureType
  ocr_detected  Boolean       @default(false)
  invoice_revision Int        @default(1)
  approval_status String      @default("PENDING")
  invalidated_at DateTime?
  invalidation_reason String?
  created_at    DateTime      @default(now())
  
  @@index([invoice_id])
  @@index([signatory_role])
  @@index([signatory_user_id])
  @@map("APInvoice_Signature")
}

model InvoiceLine {
  id                  String   @id @default(uuid())
  invoice_id          String
  invoice             Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  line_number         Int
  description         String?
  mpo_base_number     String?
  mpo_order_sequence  String?
  material_code       String?
  material_name       String?
  unit_of_measure     String?
  nextgen_unit_of_measure String?
  quantity            Decimal?
  selling_quantity    Decimal?
  unit_price          Decimal?
  line_amount         Decimal?
  matched_nextgen_line_id String?
  match_level         String?
  match_confidence    Decimal?
  match_status        String?
  received_quantity   Decimal?
  accepted_quantity   Decimal?
  previously_invoiced_quantity Decimal?
  remaining_receivable_quantity Decimal?
  previously_invoiced_amount Decimal?
  remaining_invoiceable_amount Decimal?
  nextgen_unit_price Decimal?
  size                String?
  extraction_confidence Decimal?
  field_confidence    Json?
  extraction_provenance Json?
  source_evidence     Json?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([invoice_id, line_number])
  @@index([mpo_base_number, mpo_order_sequence, material_code])
  @@map("APInvoice_InvoiceLine")
}

model InvoiceWorkflowAction {
  id                String   @id @default(uuid())
  invoice_id        String
  invoice           Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  invoice_revision  Int
  action            String
  from_stage        String?
  to_stage          String?
  reason            String?
  performed_by      String
  performed_by_role String?
  created_at        DateTime @default(now())

  @@index([invoice_id, created_at])
  @@map("APInvoice_WorkflowAction")
}

model StageTimestamp {
  id          String        @id @default(uuid())
  invoice_id  String
  invoice     Invoice       @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  stage       InvoiceStatus
  entered_at  DateTime      @default(now())
  exited_at   DateTime?
  sla_hours   Int
  is_breached Boolean       @default(false)
  
  @@index([invoice_id])
  @@index([stage])
  @@map("APInvoice_StageTimestamp")
}

model AuditLog {
  id          String   @id @default(uuid())
  invoice_id  String?
  invoice     Invoice? @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  action      String
  performed_by String?
  note        String?
  actor_name  String?
  actor_role  String?
  metadata    Json?
  correlation_id String?
  created_at  DateTime @default(now())

  @@index([invoice_id])
  @@index([created_at])
  @@map("APInvoice_AuditLog")
}

model ValidationSnapshot {
  id                String   @id @default(uuid())
  invoice_id        String
  invoice           Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  invoice_revision  Int
  validation_state  String
  source_system     String   @default("NEXTGEN")
  source_version    String?
  request_fingerprint String
  response_fingerprint String?
  request_payload   Json?
  response_payload  Json?
  rule_results      Json
  vendor_id_invoice String?
  vendor_id_source  String?
  retrieved_at      DateTime @default(now())
  created_by        String?
  superseded_at     DateTime?

  @@index([invoice_id, retrieved_at])
  @@index([request_fingerprint])
  @@map("APInvoice_ValidationSnapshot")
}

model AsyncJob {
  id              String   @id @default(uuid())
  invoice_id      String?
  invoice         Invoice? @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  job_type        String
  status          String   @default("QUEUED")
  payload         Json?
  result          Json?
  error           String?
  attempts        Int      @default(0)
  max_attempts    Int      @default(5)
  available_at    DateTime @default(now())
  claimed_at      DateTime?
  claimed_by      String?
  completed_at    DateTime?
  idempotency_key String?  @unique
  created_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([status, available_at])
  @@index([invoice_id, job_type])
  @@map("APInvoice_AsyncJob")
}

model BankChangeRequest {
  id              String   @id @default(uuid())
  invoice_id      String
  invoice         Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  field           String
  current_value   String?
  requested_value String
  reason          String
  attachment_filename  String?
  attachment_data      Bytes?
  attachment_mimetype  String?
  requested_by    String
  requested_by_id String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewed_by     String?
  reviewed_at     DateTime?
  created_at      DateTime @default(now())

  @@index([invoice_id])
  @@index([status])
  @@map("APInvoice_BankChangeRequest")
}

// Persisted vendor-master bank change requests so the requester can never
// approve their own change (requester != approver). Created via
// POST /api/vendors/:id/request-bank-update; approved implicitly when
// Accounting applies the change through /api/vendors/:id/bank-details.
model VendorBankChangeRequest {
  id              String   @id @default(uuid())
  vendor_id       String
  vendor          Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  field           String
  current_value   String?
  requested_value String
  reason          String
  phone_validation_confirmation String?
  supporting_documents Json?
  requested_by    String
  requested_by_id String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewed_by     String?
  reviewed_at     DateTime?
  created_at      DateTime @default(now())

  @@index([vendor_id])
  @@index([status])
  @@map("APInvoice_VendorBankChangeRequest")
}

model VendorBankVersion {
  id                    String   @id @default(uuid())
  vendor_id             String
  vendor                Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  version               Int
  status                String   @default("ACTIVE")
  effective_date        DateTime @default(now())
  beneficiary_name      String?
  bank_name             String?
  bank_address          String?
  account_number        String?
  swift_code            String?
  iban                  String?
  sort_code             String?
  aba_routing_number    String?
  intermediary_bank_name String?
  intermediary_bank_swift String?
  currency              String?
  payment_method        String?
  requested_by          String?
  approved_by           String?
  approval_timestamp    DateTime?
  source_request_id     String?
  created_at            DateTime @default(now())

  @@unique([vendor_id, version])
  @@index([vendor_id, status])
  @@map("APInvoice_VendorBankVersion")
}

// Immutable bank details captured for the invoice itself. Vendor-master
// changes must never rewrite this record; payment rows capture a second,
// payment-time snapshot for the bank handoff.
model InvoiceBankSnapshot {
  id                    String   @id @default(uuid())
  invoice_id            String   @unique
  invoice               Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  vendor_id             String?
  vendor_bank_version_id String?
  beneficiary_name      String?
  bank_name             String?
  bank_address          String?
  account_number        String?
  swift_code            String?
  iban                  String?
  sort_code             String?
  aba_routing_number    String?
  intermediary_bank_name String?
  intermediary_bank_swift String?
  snapshot_hash         String
  captured_at           DateTime @default(now())
  captured_by           String?
  source                String   @default("INVOICE_INTAKE")

  @@index([vendor_id])
  @@index([vendor_bank_version_id])
  @@map("APInvoice_InvoiceBankSnapshot")
}

// History for authorized invoice-level bank corrections. The current pointer
// above is convenient for payment readiness; this append-only table preserves
// every prior confirmed set for audit and payment traceability.
model InvoiceBankSnapshotRevision {
  id                    String   @id @default(uuid())
  invoice_id            String
  invoice               Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  revision              Int
  vendor_bank_version_id String?
  beneficiary_name      String?
  bank_name             String?
  bank_address          String?
  account_number        String?
  swift_code            String?
  iban                  String?
  sort_code             String?
  aba_routing_number    String?
  intermediary_bank_name String?
  intermediary_bank_swift String?
  snapshot_hash         String
  captured_at           DateTime @default(now())
  captured_by           String?
  source                String

  @@unique([invoice_id, revision])
  @@index([invoice_id, captured_at])
  @@map("APInvoice_InvoiceBankSnapshotRevision")
}

model Payment {
  id            String        @id @default(uuid())
  invoice_id    String
  invoice       Invoice       @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  vendor_id     String?
  amount        Decimal       @db.Decimal(15, 2)
  currency      String        @default("USD")
  payment_date DateTime
  // How the payment date was set: DUE_DATE (derived from invoice.due_date),
  // MANUAL (explicitly typed), or DEFAULT (fallback — invoice had no due date).
  payment_date_source String    @default("DUE_DATE")
  status        String        @default("SCHEDULED")
  batch_id      String?
  batch         PaymentBatch? @relation(fields: [batch_id], references: [id])
  paid_at       DateTime?
  reference     String?
  bank_used     String?
  remarks       String?
  hold_reason   String?
  hold_evidence Json?
  hold_owner    String?
  hold_review_date DateTime?
  // Immutable payment-authorisation snapshot. Exports must read these fields,
  // never the mutable Vendor Master record.
  beneficiary_name_snapshot String?
  bank_name_snapshot String?
  bank_address_snapshot String?
  swift_code_snapshot String?
  aba_routing_number_snapshot String?
  account_number_snapshot String?
  bank_snapshot_hash String?
  bank_snapshot_at DateTime?
  vendor_bank_verified_at_snapshot DateTime?
  invoice_revision_snapshot Int?
  // Bank charge applied at batch time (NOT at OCR). At most ONE payment per
  // batch carries a charge (one per vendor per batch, duplicates blocked).
  bank_charge_amount Decimal? @db.Decimal(15, 2)
  bank_charge_note String?
  bill_stub     BillStub?
  vendor_bill_stub_line VendorBillStubLine?
  proof_file_url String?
  proof_file_name String?
  selected_for_batch Boolean  @default(false)
  selected_by   String?
  selected_at   DateTime?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  
  @@index([invoice_id])
  @@index([invoice_id, status])
  @@index([status])
  @@index([selected_for_batch])
  @@map("APInvoice_Payment")
}

model PaymentBatch {
  id               String             @id @default(uuid())
  batch_number          String             @unique
  total_amount          Decimal            @db.Decimal(15, 2)
  payment_count         Int                @default(0)
  currency              String             @default("USD")
  status               PaymentBatchStatus  @default(DRAFT)
  created_by           String?
  processed_by         String?
  processed_at         DateTime?
  submitted_by         String?
  submitted_at         DateTime?
  reviewed_by          String?
  reviewed_at          DateTime?
  review_note          String?
  exported_at          DateTime?
  returned_by          String?
  returned_at          DateTime?
  return_reason        String?
  cancelled_by         String?
  cancelled_at         DateTime?
  cancellation_reason  String?
  // QuickBooks "Pay Bills"-style payment setup chosen by the Accounting
  // Associate while the batch is DRAFT / RETURNED_FOR_CORRECTION, before it is
  // submitted for supervisor review. Mirrors the QB Pay Bills dialog (method,
  // bank account, payment date). payment_method: CHECK | EFT | WIRE.
  payment_method        String?
  payment_bank_account  String?
  payment_date          DateTime?
  payments             Payment[]
  bill_stubs           BillStub[]
  vendor_bill_stubs    VendorBillStub[]
  created_at           DateTime           @default(now())
  @@map("APInvoice_PaymentBatch")
}

model VendorBillStub {
  id                String             @id @default(uuid())
  batch_id          String
  batch             PaymentBatch       @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  vendor_id         String
  vendor            Vendor             @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  currency          String             @default("USD")
  total_amount      Decimal            @db.Decimal(15, 2)
  payment_reference String?
  status            String             @default("DRAFT")
  return_reason     String?
  returned_by       String?
  returned_at       DateTime?
  approved_by       String?
  approved_at       DateTime?
  created_by        String?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  lines             VendorBillStubLine[]

  @@index([batch_id])
  @@index([vendor_id])
  @@map("APInvoice_VendorBillStub")
}

model VendorBillStubLine {
  id           String        @id @default(uuid())
  bill_stub_id String
  bill_stub    VendorBillStub @relation(fields: [bill_stub_id], references: [id], onDelete: Cascade)
  payment_id   String        @unique
  payment      Payment       @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  invoice_id   String
  amount       Decimal       @db.Decimal(15, 2)
  created_at   DateTime      @default(now())

  @@index([bill_stub_id])
  @@index([invoice_id])
  @@map("APInvoice_VendorBillStubLine")
}

model BillStub {
  id              String    @id @default(uuid())
  batch_id        String?
  batch           PaymentBatch? @relation(fields: [batch_id], references: [id], onDelete: SetNull)
  payment_id      String    @unique
  payment         Payment   @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  // QB Pay Bills bill-stub header
  stub_date       DateTime?
  type            String?
  reference       String?
  original_amount Decimal?  @db.Decimal(15, 2)
  balance         Decimal?  @db.Decimal(15, 2)
  discount        Decimal?  @db.Decimal(15, 2)
  // "Payment" column of the bill stub = amount paid on this stub
  paid_amount     Decimal?  @db.Decimal(15, 2)
  proof_file_url  String?
  proof_file_name String?
  created_by      String?
  created_at      DateTime  @default(now())

  @@index([batch_id])
  @@map("APInvoice_BillStub")
}

model PaymentConfirmation {
  id              String   @id @default(uuid())
  invoice_id      String
  invoice         Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  payment_id      String?
  vendor_name     String
  vendor_email    String?
  amount          Decimal  @db.Decimal(15, 2)
  currency        String   @default("USD")
  payment_reference String?
  email_sent      Boolean  @default(false)
  cc_email        String?
  sent_by         String?
  sent_at         DateTime @default(now())
  created_at      DateTime @default(now())

  @@index([invoice_id])
  @@index([sent_at])
  @@map("APInvoice_PaymentConfirmation")
}

model ApiKey {
  id          String   @id @default(uuid())
  key_hash    String   @unique
  key_prefix  String
  name        String
  created_by  String
  created_at  DateTime @default(now())
  revoked_at  DateTime?
  last_used_at DateTime?
  expires_at  DateTime?

  @@index([key_hash])
  @@map("APInvoice_ApiKey")
}

model FollowUpTask {
  id               String   @id @default(uuid())
  invoice_id       String
  invoice          Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  task_type        String
  assigned_to      String
  due_date         DateTime
  status           String   @default("PENDING")
  reminder_count   Int      @default(0)
  last_reminded_at DateTime?
  completed_at     DateTime?
  notes            String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  
  @@index([invoice_id])
  @@index([assigned_to])
  @@index([status])
  @@index([due_date])
  @@map("APInvoice_FollowUpTask")
}

